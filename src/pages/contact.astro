---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site.config';
---

<Layout
  title="Contactez ALUBAT Guadeloupe — Ateliers & Devis Gratuit"
  description="Contactez nos ateliers ALUBAT à Baie-Mahault Jarry. Demandez une étude personnalisée et un devis gratuit pour vos menuiseries aluminium en Guadeloupe."
>
  <!-- Hero Section -->
  <section class="bg-zinc-950 text-white py-16 sm:py-20 border-b border-zinc-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="inline-block text-xs font-bold uppercase tracking-widest text-sky-400 bg-sky-950/80 border border-sky-800/60 px-3 py-1 rounded-full mb-4">
          Ateliers & Siège Social Jarry
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-6">
          Contact & Demande de Devis
        </h1>
        <p class="text-base sm:text-xl text-zinc-300 leading-relaxed">
          Nos conseillers techniques et métreurs sont à votre écoute du lundi au vendredi de 8h à 16h pour étudier vos projets de menuiserie aluminium en neuf comme en rénovation.
        </p>
      </div>
    </div>
  </section>

  <!-- Contenu Principal -->
  <section class="py-16 sm:py-20 bg-zinc-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <!-- Coordonnées & Accès -->
        <div class="lg:col-span-5 space-y-8">
          <div class="bg-white p-8 rounded-2xl border border-zinc-200/90 shadow-xs">
            <h2 class="text-xl font-bold text-zinc-900 tracking-tight mb-6 flex items-center space-x-2">
              <span>📍</span>
              <span>Nos Coordonnées</span>
            </h2>

            <div class="space-y-6 text-sm text-zinc-600">
              <div class="flex items-start space-x-4">
                <div class="p-2.5 rounded-lg bg-zinc-100 text-zinc-800 shrink-0">
                  🏢
                </div>
                <div>
                  <strong class="block text-zinc-900 font-semibold mb-1">Siège & Ateliers de fabrication</strong>
                  <p>{siteConfig.contact.address}</p>
                  <p>{siteConfig.contact.postalCode} {siteConfig.contact.city}, Guadeloupe</p>
                </div>
              </div>

              <div class="flex items-start space-x-4">
                <div class="p-2.5 rounded-lg bg-zinc-100 text-zinc-800 shrink-0">
                  📞
                </div>
                <div>
                  <strong class="block text-zinc-900 font-semibold mb-1">Téléphone direct</strong>
                  <a href={`tel:${siteConfig.contact.phone}`} class="text-sky-600 hover:text-sky-700 font-bold text-base">
                    {siteConfig.contact.phoneFormatted}
                  </a>
                  <p class="text-xs text-zinc-500 mt-0.5">Appel non surtaxé</p>
                </div>
              </div>

              <div class="flex items-start space-x-4">
                <div class="p-2.5 rounded-lg bg-zinc-100 text-zinc-800 shrink-0">
                  ✉️
                </div>
                <div>
                  <strong class="block text-zinc-900 font-semibold mb-1">Courrier électronique</strong>
                  <a href={`mailto:${siteConfig.contact.email}`} class="text-zinc-900 hover:text-sky-600 font-medium">
                    {siteConfig.contact.email}
                  </a>
                </div>
              </div>

              <div class="flex items-start space-x-4">
                <div class="p-2.5 rounded-lg bg-zinc-100 text-zinc-800 shrink-0">
                  🕒
                </div>
                <div>
                  <strong class="block text-zinc-900 font-semibold mb-1">Horaires d'ouverture</strong>
                  <p class="font-medium text-zinc-800">{siteConfig.contact.hours}</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Encadré Savoir-Faire -->
          <div class="bg-zinc-900 text-white p-8 rounded-2xl border border-zinc-800 shadow-md">
            <h3 class="text-lg font-bold text-white mb-3">
              3 000 m² d'Ateliers Locaux
            </h3>
            <p class="text-xs text-zinc-300 leading-relaxed mb-4">
              Chez ALUBAT, chaque baie, porte ou pergola est usinée et assemblée localement par des techniciens qualifiés, garantissant un contrôle qualité irréprochable et un service après-vente réactif partout en Guadeloupe.
            </p>
            <div class="flex items-center space-x-2 text-xs font-semibold text-sky-400">
              <span>✓ Normes paracycloniques antillaises</span>
            </div>
          </div>
        </div>

        <!-- Formulaire de Devis & Contact -->
        <div class="lg:col-span-7">
          <div class="bg-white p-8 sm:p-10 rounded-2xl border border-zinc-200/90 shadow-sm">
            <h2 class="text-2xl font-extrabold text-zinc-900 tracking-tight mb-2">
              Demande de Chiffrage Gratuit
            </h2>
            <p class="text-xs text-zinc-600 mb-8">
              Remplissez ce formulaire pour recevoir un devis personnalisé ou convenir d'une visite sur votre chantier.
            </p>

            <form
              action="mailto:contact@alubat971.com"
              method="GET"
              class="space-y-6"
            >
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label for="name" class="block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-2">
                    Nom et Prénom *
                  </label>
                  <input
                    type="text"
                    id="name"
                    name="subject"
                    required
                    placeholder="M. Jean Dupont"
                    class="w-full px-4 py-3 rounded-lg border border-zinc-300 focus:outline-hidden focus:ring-2 focus:ring-sky-500 text-sm"
                  />
                </div>

                <div>
                  <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-2">
                    Téléphone *
                  </label>
                  <input
                    type="tel"
                    id="phone"
                    required
                    placeholder="0690 .. .. .."
                    class="w-full px-4 py-3 rounded-lg border border-zinc-300 focus:outline-hidden focus:ring-2 focus:ring-sky-500 text-sm"
                  />
                </div>
              </div>

              <div>
                <label for="email" class="block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-2">
                  Adresse Email *
                </label>
                <input
                  type="email"
                  id="email"
                  required
                  placeholder="exemple@email.com"
                  class="w-full px-4 py-3 rounded-lg border border-zinc-300 focus:outline-hidden focus:ring-2 focus:ring-sky-500 text-sm"
                />
              </div>

              <div>
                <label for="type" class="block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-2">
                  Type de Projet
                </label>
                <select
                  id="type"
                  class="w-full px-4 py-3 rounded-lg border border-zinc-300 focus:outline-hidden focus:ring-2 focus:ring-sky-500 text-sm bg-white"
                >
                  <option value="baies">Baies Coulissantes / Baies Vitrées</option>
                  <option value="pergolas">Pergola Bioclimatique Biossun</option>
                  <option value="volets">Volets Roulants Paracycloniques</option>
                  <option value="portes">Porte d'Entrée Volma / Blindée</option>
                  <option value="garde-corps">Garde-Corps & Clôtures Horizal</option>
                  <option value="portes-automatiques">Porte Automatique / SAS Vitré</option>
                  <option value="autre">Autre projet sur-mesure</option>
                </select>
              </div>

              <div>
                <label for="message" class="block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-2">
                  Description du Projet & Dimensions approximatives
                </label>
                <textarea
                  id="message"
                  name="body"
                  rows="5"
                  placeholder="Précisez votre commune (ex: Gosier, Baie-Mahault, Saint-François...), neuf ou rénovation, dimensions et attentes..."
                  class="w-full px-4 py-3 rounded-lg border border-zinc-300 focus:outline-hidden focus:ring-2 focus:ring-sky-500 text-sm"
                ></textarea>
              </div>

              <button
                type="submit"
                class="w-full py-4 rounded-xl bg-sky-600 hover:bg-sky-500 text-white font-extrabold text-sm uppercase tracking-wider shadow-md hover:shadow-lg transition-all"
              >
                Envoyer ma demande de devis
              </button>

              <p class="text-[11px] text-zinc-500 text-center">
                Vos données sont strictement confidentielles et ne sont jamais transmises à des tiers.
              </p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
