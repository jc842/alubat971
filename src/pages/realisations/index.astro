---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const realisations = await getCollection('realisations', ({ data }) => !data.lang || data.lang === 'fr');
const sortedRealisations = realisations.sort((a, b) => {
  const dateA = a.data.pubDate ? new Date(a.data.pubDate).getTime() : 0;
  const dateB = b.data.pubDate ? new Date(b.data.pubDate).getTime() : 0;
  return dateB - dateA;
});
---

<Layout
  title="Nos Réalisations & Chantiers de Référence en Guadeloupe"
  description="Explorez les chantiers et réalisations emblématiques d'ALUBAT Guadeloupe : hôtels de luxe, villas contemporaines, bâtiments commerciaux et résidences de prestige."
>
  <!-- Hero Section -->
  <section class="bg-zinc-950 text-white py-16 sm:py-24 border-b border-zinc-800 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl">
        <span class="inline-block text-xs font-bold uppercase tracking-widest text-sky-400 bg-sky-950/80 border border-sky-800/60 px-3 py-1 rounded-full mb-4">
          Portfolio & Références BTP
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-6">
          Nos Réalisations d'Exception en Guadeloupe
        </h1>
        <p class="text-base sm:text-xl text-zinc-300 leading-relaxed mb-8">
          Hôtels, villas d'architecte, ensembles tertiaires et logements de standing : découvrez le savoir-faire de nos équipes de fabrication et de pose.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="/contact/"
            class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-sky-600 text-white font-bold hover:bg-sky-500 transition-colors shadow-md text-sm"
          >
            Nous confier votre projet
          </a>
          <a
            href="tel:0590266440"
            class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-zinc-800 text-zinc-200 border border-zinc-700 font-semibold hover:bg-zinc-700 transition-colors text-sm"
          >
            Contacter un chargé d'affaires
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Grille Réalisations -->
  <section class="py-16 sm:py-20 bg-zinc-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 border-b border-zinc-200 pb-6">
        <div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 tracking-tight">
            Chantiers & Projets livrés
          </h2>
          <p class="text-sm text-zinc-600 mt-2">
            24 réalisations illustrant la polyvalence et la rigueur d'ALUBAT Guadeloupe.
          </p>
        </div>
        <div class="mt-4 md:mt-0 text-xs font-semibold text-zinc-500">
          {sortedRealisations.length} chantiers présentés
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sortedRealisations.map((real) => (
          <article class="bg-white rounded-2xl border border-zinc-200/90 overflow-hidden shadow-xs hover:shadow-lg hover:border-zinc-300 transition-all flex flex-col group">
            <div class="relative h-64 bg-zinc-100 overflow-hidden">
              {real.data.heroImage ? (
                <img
                  src={real.data.heroImage}
                  alt={real.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-zinc-400">
                  <span class="text-xs uppercase tracking-widest font-bold">ALUBAT Guadeloupe</span>
                </div>
              )}
              <span class="absolute bottom-3 left-3 bg-zinc-950/80 backdrop-blur-md text-white text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-md">
                Guadeloupe
              </span>
            </div>

            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="text-lg font-bold text-zinc-950 tracking-tight group-hover:text-sky-600 transition-colors mb-2">
                  <a href={`/realisations/${real.id}/`}>
                    {real.data.title}
                  </a>
                </h3>
                <p class="text-xs text-zinc-600 line-clamp-3 leading-relaxed mb-4">
                  {real.data.description}
                </p>
              </div>

              <div class="pt-4 border-t border-zinc-100 flex items-center justify-between">
                <span class="text-xs font-semibold text-zinc-400">Projet Référence</span>
                <a
                  href={`/realisations/${real.id}/`}
                  class="text-xs font-bold text-sky-600 group-hover:text-sky-700 flex items-center space-x-1"
                >
                  <span>Découvrir le chantier</span>
                  <span aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
