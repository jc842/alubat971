---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const realisations = await getCollection('realisations', ({ data }) => !data.lang || data.lang === 'fr');
  return realisations.map(real => ({
    params: { slug: real.id },
    props: { real },
  }));
}

const { real } = Astro.props;
const { Content } = await render(real);

// Autres réalisations
const allRealisations = await getCollection('realisations', ({ data }) => !data.lang || data.lang === 'fr');
const otherRealisations = allRealisations.filter(r => r.id !== real.id).slice(0, 3);
---

<Layout
  title={`${real.data.title} — Réalisation ALUBAT Guadeloupe`}
  description={real.data.description}
  image={real.data.heroImage}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Fil d'ariane -->
    <nav class="flex items-center space-x-2 text-xs text-zinc-500 mb-8 overflow-hidden whitespace-nowrap">
      <a href="/" class="hover:underline">Accueil</a>
      <span>/</span>
      <a href="/realisations/" class="hover:underline">Nos Réalisations</a>
      <span>/</span>
      <span class="text-zinc-900 font-semibold truncate">{real.data.title}</span>
    </nav>

    <article class="bg-white rounded-2xl border border-zinc-200/90 overflow-hidden shadow-xs p-6 sm:p-12 mb-16">
      <header class="mb-8">
        <span class="inline-block text-xs font-bold uppercase tracking-wider text-sky-800 bg-sky-100 border border-sky-300 px-3 py-1 rounded-md mb-4">
          Chantier Référence Guadeloupe
        </span>
        <h1 class="text-2xl sm:text-4xl font-extrabold text-zinc-950 tracking-tight leading-tight mb-4">
          {real.data.title}
        </h1>
        {real.data.description && (
          <p class="text-base text-zinc-600 leading-relaxed max-w-3xl">
            {real.data.description}
          </p>
        )}
      </header>

      {real.data.heroImage && (
        <div class="mb-10 rounded-xl overflow-hidden shadow-sm border border-zinc-200">
          <img
            src={real.data.heroImage}
            alt={real.data.title}
            class="w-full h-auto max-h-[600px] object-cover"
            loading="eager"
          />
        </div>
      )}

      <div class="prose prose-zinc max-w-none leading-relaxed border-t border-zinc-100 pt-8">
        <Content />
      </div>

      <!-- Bloc Devis Projet -->
      <div class="mt-12 p-8 bg-zinc-950 text-white rounded-xl flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <h3 class="text-lg font-bold text-white mb-1">
            Vous avez un projet similaire en Guadeloupe ?
          </h3>
          <p class="text-xs text-zinc-300">
            Nos bureaux d'études et nos métreurs interviennent sur toute l'île.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a
            href="/contact/"
            class="px-6 py-2.5 rounded-lg bg-sky-600 hover:bg-sky-500 font-bold text-xs text-white transition-colors"
          >
            Demander un chiffrage
          </a>
          <a
            href="tel:0590266440"
            class="px-6 py-2.5 rounded-lg bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 font-semibold text-xs text-zinc-200 transition-colors"
          >
            0590 26 64 40
          </a>
        </div>
      </div>
    </article>

    <!-- Autres Projets -->
    {otherRealisations.length > 0 && (
      <section class="border-t border-zinc-200 pt-10">
        <h2 class="text-xl sm:text-2xl font-extrabold text-zinc-900 tracking-tight mb-6">
          Découvrir d'autres chantiers
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {otherRealisations.map((item) => (
            <a
              href={`/realisations/${item.id}/`}
              class="group bg-white rounded-xl border border-zinc-200 p-4 hover:border-zinc-300 hover:shadow-md transition-all flex flex-col"
            >
              <div class="h-40 bg-zinc-100 rounded-lg overflow-hidden mb-3">
                {item.data.heroImage && (
                  <img src={item.data.heroImage} alt={item.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
                )}
              </div>
              <h3 class="text-sm font-bold text-zinc-900 group-hover:text-sky-600 transition-colors">
                {item.data.title}
              </h3>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>
