---
import { catLabel } from '../../lib/categories';
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft && (!data.lang || data.lang === 'fr'));
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Actualités & Guides Techniques de la Menuiserie en Guadeloupe"
  description="Retrouvez tous les conseils, actualités et guides techniques d'ALUBAT Guadeloupe : normes paracycloniques, aides financières, entretien de l'aluminium et innovations."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <header class="mb-14 pb-8 border-b border-zinc-200">
      <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-sky-600 font-semibold">Le Journal Technique ALUBAT</span>
      <h1 class="font-sans text-3xl sm:text-5xl font-extrabold text-zinc-950 tracking-tight mt-2 mb-3">
        Actualités & Conseils Menuiserie
      </h1>
      <p class="text-zinc-600 text-sm sm:text-base max-w-2xl">
        Conseils d'experts sur les normes anticycloniques, le crédit d'impôt en Guadeloupe, l'entretien des vitrages en milieu marin et les réalisations de nos ateliers.
      </p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map(post => (
        <article class="bg-white rounded-2xl border border-zinc-200/80 overflow-hidden shadow-xs hover:shadow-lg transition-all flex flex-col">
          {post.data.heroImage && (
            <a href={`/blog/${post.id}/`} class="aspect-[16/10] overflow-hidden bg-zinc-100 block group">
              <img
                src={post.data.heroImage}
                alt={post.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </a>
          )}
          <div class="p-6 flex flex-col flex-grow">
            <span class="text-[10px] font-bold uppercase tracking-wider text-sky-800 bg-sky-50 border border-sky-200 rounded px-2.5 py-0.5 w-fit mb-3">
              {catLabel(post.data.category)}
            </span>
            <h3 class="font-sans text-base sm:text-lg font-bold text-zinc-900 hover:text-sky-600 transition-colors line-clamp-2 mb-3">
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h3>
            <p class="text-xs text-zinc-600 line-clamp-3 mb-6 flex-grow leading-relaxed">
              {post.data.description}
            </p>
            <div class="flex items-center justify-between pt-4 border-t border-zinc-100 text-xs text-zinc-400">
              <span>{new Date(post.data.pubDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
              <a href={`/blog/${post.id}/`} class="font-bold text-sky-600 hover:text-sky-700 uppercase tracking-wider">
                Lire &rarr;
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
