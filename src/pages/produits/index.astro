---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../config/site.config';

const produits = await getCollection('produits', ({ data }) => !data.lang || data.lang === 'fr');

// Trier par date ou titre
const sortedProduits = produits.sort((a, b) => a.data.title.localeCompare(b.data.title));

// Liste des catégories uniques
const categories = Array.from(new Set(produits.map(p => p.data.category).filter(Boolean)));
---

<Layout
  title="Gamme Menuiseries Aluminium — Baies, Pergolas, Volets & Portes"
  description="Découvrez l'ensemble de notre gamme de menuiseries aluminium fabriquées sur-mesure en Guadeloupe : baies coulissantes, pergolas bioclimatiques, volets paracycloniques et portes d'entrée."
>
  <!-- Hero Section Bastion -->
  <section class="bg-zinc-950 text-white py-16 sm:py-24 border-b border-zinc-800 relative overflow-hidden">
    <div class="absolute inset-0 bg-radial from-zinc-800/40 via-transparent to-transparent pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl">
        <span class="inline-block text-xs font-bold uppercase tracking-widest text-sky-400 bg-sky-950/80 border border-sky-800/60 px-3 py-1 rounded-full mb-4">
          Catalogue & Gamme Professionnelle
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-6">
          Menuiseries Aluminium de Précision Fabriquées en Guadeloupe
        </h1>
        <p class="text-base sm:text-xl text-zinc-300 leading-relaxed mb-8">
          Conçues et assemblées dans nos ateliers de 3 000 m² à Jarry. Solutions haute performance thermique, acoustique et paracyclonique conformes aux normes antillaises.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="/contact/"
            class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-sky-600 text-white font-bold hover:bg-sky-500 transition-colors shadow-md text-sm"
          >
            Demander une étude & un devis
          </a>
          <a
            href="tel:0590266440"
            class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-zinc-800 text-zinc-200 border border-zinc-700 font-semibold hover:bg-zinc-700 transition-colors text-sm"
          >
            📞 0590 26 64 40
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Grille de Produits Bastion -->
  <section class="py-16 sm:py-20 bg-zinc-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 border-b border-zinc-200 pb-6">
        <div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 tracking-tight">
            Toutes nos solutions aluminium
          </h2>
          <p class="text-sm text-zinc-600 mt-2">
            38 références certifiées pour le résidentiel haut de gamme, les commerces et le tertiaire.
          </p>
        </div>
        <div class="mt-4 md:mt-0 text-xs font-semibold text-zinc-500">
          Affichage de {sortedProduits.length} produits
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sortedProduits.map((prod) => (
          <article class="bg-white rounded-2xl border border-zinc-200/90 overflow-hidden shadow-xs hover:shadow-md hover:border-zinc-300 transition-all flex flex-col group">
            <div class="relative h-60 bg-zinc-100 overflow-hidden">
              {prod.data.heroImage ? (
                <img
                  src={prod.data.heroImage}
                  alt={prod.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-zinc-400">
                  <span class="text-xs uppercase tracking-widest font-bold">ALUBAT Guadeloupe</span>
                </div>
              )}
              {prod.data.brand && prod.data.brand !== 'ALUBAT' && (
                <span class="absolute top-3 right-3 bg-zinc-950/80 backdrop-blur-md text-white text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-md border border-white/20">
                  Partenaire {prod.data.brand}
                </span>
              )}
              <span class="absolute bottom-3 left-3 bg-white/90 backdrop-blur-md text-zinc-900 text-[11px] font-semibold px-2.5 py-0.5 rounded-md shadow-xs">
                {prod.data.category}
              </span>
            </div>

            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="text-lg font-bold text-zinc-950 tracking-tight group-hover:text-sky-600 transition-colors mb-2">
                  <a href={`/produits/${prod.id}/`}>
                    {prod.data.title}
                  </a>
                </h3>
                <p class="text-xs text-zinc-600 line-clamp-3 leading-relaxed mb-4">
                  {prod.data.description}
                </p>
              </div>

              <div class="pt-4 border-t border-zinc-100 flex items-center justify-between">
                <span class="text-xs font-semibold text-zinc-500">Fabrication sur-mesure</span>
                <a
                  href={`/produits/${prod.id}/`}
                  class="text-xs font-bold text-sky-600 group-hover:text-sky-700 flex items-center space-x-1"
                >
                  <span>Voir fiche technique</span>
                  <span aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Bandeau Appel / Devis -->
  <section class="bg-white py-14 border-t border-zinc-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 tracking-tight mb-4">
        Un projet architectural spécifique en Guadeloupe ?
      </h2>
      <p class="text-base text-zinc-600 max-w-2xl mx-auto mb-8">
        Nos techniciens et bureaux d'études vous accompagnent de la prise de côtes à l'installation finale sur site.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/contact/"
          class="px-8 py-3.5 rounded-lg bg-zinc-950 text-white font-bold hover:bg-zinc-800 transition-colors text-sm shadow-md"
        >
          Demander une étude technique gratuite
        </a>
        <a
          href="tel:0590266440"
          class="px-8 py-3.5 rounded-lg bg-zinc-100 text-zinc-900 border border-zinc-300 font-bold hover:bg-zinc-200 transition-colors text-sm"
        >
          Appeler nos ateliers : 0590 26 64 40
        </a>
      </div>
    </div>
  </section>
</Layout>
