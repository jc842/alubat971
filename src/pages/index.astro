---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site.config';

// Récupérer les produits en vedette
const allProduits = await getCollection('produits', ({ data }) => !data.lang || data.lang === 'fr');
const featuredProduits = allProduits.slice(0, 6);

// Récupérer les chantiers phares
const allRealisations = await getCollection('realisations', ({ data }) => !data.lang || data.lang === 'fr');
const featuredRealisations = allRealisations.slice(0, 4);

// Récupérer les derniers articles de blog
const allPosts = await getCollection('blog', ({ data }) => !data.lang || data.lang === 'fr');
const sortedPosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 3);
---

<Layout
  title="ALUBAT Guadeloupe — Fabricant & Installateur de Menuiseries Aluminium à Jarry"
  description="Fabricant et installateur de menuiseries aluminium en Guadeloupe depuis plus de 25 ans. 3 000 m² d'ateliers à Jarry : baies coulissantes, pergolas bioclimatiques, volets paracycloniques, portes d'entrée et façades vitrées."
>
  <!-- Hero Section Lexington Bastion -->
  <section class="relative bg-zinc-950 text-white min-h-[85vh] flex flex-col justify-center border-b border-zinc-800 overflow-hidden">
    <!-- Fond texturé subtil -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-zinc-800/40 via-zinc-950 to-zinc-950 pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 relative z-10 w-full">
      <div class="max-w-3xl">
        <div class="inline-flex items-center space-x-2 bg-sky-950/80 border border-sky-800/60 px-3.5 py-1.5 rounded-full mb-6">
          <span class="w-2 h-2 rounded-full bg-sky-400 animate-pulse"></span>
          <span class="text-xs font-bold uppercase tracking-widest text-sky-300">
            Ateliers de 3 000 m² à Jarry • Baie-Mahault
          </span>
        </div>

        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white leading-tight mb-6">
          Menuiseries Aluminium de Haute Précision en Guadeloupe
        </h1>

        <p class="text-lg sm:text-xl text-zinc-300 leading-relaxed mb-10 max-w-2xl">
          Depuis plus de 25 ans, ALUBAT conçoit, fabrique et installe sur-mesure toutes vos ouvertures aluminium adaptées aux exigences climatiques et paracycloniques antillaises.
        </p>

        <div class="flex flex-wrap gap-4">
          <a
            href="/produits/"
            class="px-8 py-4 rounded-xl bg-sky-600 hover:bg-sky-500 font-extrabold text-sm uppercase tracking-wider text-white transition-all shadow-lg hover:shadow-sky-500/20"
          >
            Découvrir notre Gamme
          </a>
          <a
            href="/contact/"
            class="px-8 py-4 rounded-xl bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 font-bold text-sm uppercase tracking-wider text-zinc-100 transition-colors"
          >
            Demander un Devis Gratuit
          </a>
          <a
            href="tel:0590266440"
            class="px-6 py-4 rounded-xl bg-transparent hover:bg-zinc-900 border border-zinc-800 font-semibold text-sm text-zinc-300 flex items-center space-x-2"
          >
            <span>📞</span>
            <span>0590 26 64 40</span>
          </a>
        </div>
      </div>

      <!-- Chiffres Clés Bastion -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mt-16 pt-12 border-t border-zinc-800/80">
        <div>
          <span class="block text-3xl sm:text-4xl font-extrabold text-white">3 000 m²</span>
          <span class="text-xs uppercase tracking-wider text-zinc-400 font-medium mt-1">D'ateliers à Jarry</span>
        </div>
        <div>
          <span class="block text-3xl sm:text-4xl font-extrabold text-white">25+ ans</span>
          <span class="text-xs uppercase tracking-wider text-zinc-400 font-medium mt-1">D'expertise locale</span>
        </div>
        <div>
          <span class="block text-3xl sm:text-4xl font-extrabold text-white">100%</span>
          <span class="text-xs uppercase tracking-wider text-zinc-400 font-medium mt-1">Sur-mesure certifié</span>
        </div>
        <div>
          <span class="block text-3xl sm:text-4xl font-extrabold text-sky-400">Cyclones</span>
          <span class="text-xs uppercase tracking-wider text-zinc-400 font-medium mt-1">Normes paracycloniques</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 1 : Gamme de Produits en Vedette -->
  <section class="py-20 bg-zinc-50 border-b border-zinc-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-sky-600 block mb-2">
            Fabrication Locale
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-zinc-950 tracking-tight">
            Nos Solutions de Menuiserie Aluminium
          </h2>
          <p class="text-sm text-zinc-600 mt-2 max-w-xl">
            Des gammes performantes conçues pour résister aux embruns marins, à la chaleur tropicale et aux vents cycloniques.
          </p>
        </div>
        <a
          href="/produits/"
          class="mt-4 md:mt-0 text-sm font-bold text-sky-600 hover:text-sky-700 flex items-center space-x-1"
        >
          <span>Voir tout le catalogue (38 produits)</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredProduits.map((prod) => (
          <article class="bg-white rounded-2xl border border-zinc-200/90 overflow-hidden shadow-xs hover:shadow-lg transition-all flex flex-col group">
            <div class="relative h-56 bg-zinc-100 overflow-hidden">
              {prod.data.heroImage ? (
                <img
                  src={prod.data.heroImage}
                  alt={prod.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-zinc-400">
                  <span class="text-xs uppercase font-bold tracking-widest">ALUBAT Guadeloupe</span>
                </div>
              )}
              {prod.data.brand && prod.data.brand !== 'ALUBAT' && (
                <span class="absolute top-3 right-3 bg-zinc-950/80 backdrop-blur-md text-white text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-md border border-white/20">
                  {prod.data.brand}
                </span>
              )}
            </div>

            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <span class="text-[11px] font-bold uppercase tracking-wider text-sky-700 block mb-1">
                  {prod.data.category}
                </span>
                <h3 class="text-lg font-bold text-zinc-950 tracking-tight group-hover:text-sky-600 transition-colors mb-2">
                  <a href={`/produits/${prod.id}/`}>
                    {prod.data.title}
                  </a>
                </h3>
                <p class="text-xs text-zinc-600 line-clamp-2 leading-relaxed">
                  {prod.data.description}
                </p>
              </div>

              <div class="pt-4 mt-4 border-t border-zinc-100 flex items-center justify-between">
                <span class="text-xs text-zinc-500 font-medium">Sur-mesure</span>
                <a
                  href={`/produits/${prod.id}/`}
                  class="text-xs font-bold text-sky-600 group-hover:text-sky-700 flex items-center space-x-1"
                >
                  <span>Consulter</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 2 : Savoir-Faire & Ateliers de Jarry -->
  <section class="py-20 bg-zinc-950 text-white border-b border-zinc-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-6">
          <span class="text-xs font-bold uppercase tracking-widest text-sky-400 block mb-3">
            3 000 m² de Capacité Industrielle
          </span>
          <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight mb-6">
            Fabrication Locale & Maîtrise Technique Totale
          </h2>
          <p class="text-sm sm:text-base text-zinc-300 leading-relaxed mb-6">
            Implantée au cœur de la zone industrielle de Jarry à Baie-Mahault, ALUBAT dispose d'un outil de production complet permettant la réalisation des chantiers les plus complexes : baies vitrées de grandes portées, murs-rideaux de façades tertiaires, brise-soleil orientables et pergolas bioclimatiques.
          </p>
          <div class="space-y-4 text-sm text-zinc-300">
            <div class="flex items-start space-x-3">
              <span class="text-sky-400 font-bold">✓</span>
              <p><strong class="text-white">Bureau d'études intégré :</strong> Calculs de structure, dimensionnement paracyclonique et plans d'exécution sur-mesure.</p>
            </div>
            <div class="flex items-start space-x-3">
              <span class="text-sky-400 font-bold">✓</span>
              <p><strong class="text-white">Thermolaquage haute durabilité :</strong> Finitions labellisées Qualicoat et Qualimarine pour une tenue exemplaire face aux UV et aux embruns salins.</p>
            </div>
            <div class="flex items-start space-x-3">
              <span class="text-sky-400 font-bold">✓</span>
              <p><strong class="text-white">Équipes de pose intégrées :</strong> Nos techniciens qualifiés interviennent sur toute la Guadeloupe en site libre ou occupé.</p>
            </div>
          </div>
          <div class="mt-8 flex gap-4">
            <a
              href="/nos-valeurs/"
              class="px-6 py-3 rounded-lg bg-white text-zinc-950 font-bold text-xs uppercase tracking-wider hover:bg-zinc-200 transition-colors"
            >
              Découvrir nos engagements
            </a>
            <a
              href="/architectes/"
              class="px-6 py-3 rounded-lg bg-zinc-800 text-zinc-200 border border-zinc-700 font-bold text-xs uppercase tracking-wider hover:bg-zinc-700 transition-colors"
            >
              Espace Architectes
            </a>
          </div>
        </div>

        <div class="lg:col-span-6 grid grid-cols-2 gap-4">
          <div class="bg-zinc-900 border border-zinc-800 p-6 rounded-2xl">
            <span class="text-2xl mb-3 block">🏢</span>
            <h3 class="text-base font-bold text-white mb-2">Tertiaire & Public</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              CHUs, hôtels, centres commerciaux, agences bancaires et collèges de Guadeloupe.
            </p>
          </div>
          <div class="bg-zinc-900 border border-zinc-800 p-6 rounded-2xl">
            <span class="text-2xl mb-3 block">🏡</span>
            <h3 class="text-base font-bold text-white mb-2">Villas & Résidentiel</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Villas contemporaines de standing, fermetures sur-mesure et pergolas bioclimatiques.
            </p>
          </div>
          <div class="bg-zinc-900 border border-zinc-800 p-6 rounded-2xl">
            <span class="text-2xl mb-3 block">🌪️</span>
            <h3 class="text-base font-bold text-white mb-2">Paracyclonique</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Menuiseries testées et homologuées pour résister aux pressions de vent extrêmes.
            </p>
          </div>
          <div class="bg-zinc-900 border border-zinc-800 p-6 rounded-2xl">
            <span class="text-2xl mb-3 block">🤝</span>
            <h3 class="text-base font-bold text-white mb-2">Grandes Marques</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Schüco, Biossun, Volma, Horizal, Dessol : l'élite de la menuiserie internationale.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3 : Chantiers de Référence en Guadeloupe -->
  <section class="py-20 bg-white border-b border-zinc-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-sky-600 block mb-2">
            Références Chantiers
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-zinc-950 tracking-tight">
            Nos Dernières Réalisations en Guadeloupe
          </h2>
          <p class="text-sm text-zinc-600 mt-2 max-w-xl">
            Quelques aperçus de nos chantiers récemment livrés à travers l'archipel.
          </p>
        </div>
        <a
          href="/realisations/"
          class="mt-4 md:mt-0 text-sm font-bold text-sky-600 hover:text-sky-700 flex items-center space-x-1"
        >
          <span>Consulter toutes les réalisations (24 projets)</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {featuredRealisations.map((real) => (
          <article class="bg-zinc-50 rounded-2xl border border-zinc-200 overflow-hidden shadow-xs hover:shadow-md transition-all flex flex-col group">
            <div class="h-48 bg-zinc-200 overflow-hidden relative">
              {real.data.heroImage && (
                <img
                  src={real.data.heroImage}
                  alt={real.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              )}
            </div>
            <div class="p-5 flex-1 flex flex-col justify-between">
              <h3 class="text-sm font-bold text-zinc-900 group-hover:text-sky-600 transition-colors line-clamp-2 mb-2">
                <a href={`/realisations/${real.id}/`}>
                  {real.data.title}
                </a>
              </h3>
              <a
                href={`/realisations/${real.id}/`}
                class="text-xs font-semibold text-sky-600 hover:underline pt-2 border-t border-zinc-200 block"
              >
                Voir les photos &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 4 : Dernières Actualités & Conseils -->
  {sortedPosts.length > 0 && (
    <section class="py-20 bg-zinc-50 border-b border-zinc-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
          <div>
            <span class="text-xs font-bold uppercase tracking-widest text-sky-600 block mb-2">
              Le Mag ALUBAT
            </span>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-zinc-950 tracking-tight">
              Conseils, Normes & Actualités
            </h2>
          </div>
          <a
            href="/blog/"
            class="mt-4 md:mt-0 text-sm font-bold text-sky-600 hover:text-sky-700 flex items-center space-x-1"
          >
            <span>Tous nos articles (20 guides)</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {sortedPosts.map((post) => (
            <article class="bg-white rounded-2xl border border-zinc-200 overflow-hidden shadow-xs hover:shadow-md transition-all flex flex-col group">
              <div class="h-48 bg-zinc-100 overflow-hidden">
                {post.data.heroImage && (
                  <img
                    src={post.data.heroImage}
                    alt={post.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform"
                    loading="lazy"
                  />
                )}
              </div>
              <div class="p-6 flex-1 flex flex-col justify-between">
                <div>
                  <span class="text-[11px] font-bold uppercase tracking-wider text-sky-700 block mb-2">
                    {post.data.category}
                  </span>
                  <h3 class="text-base font-bold text-zinc-900 group-hover:text-sky-600 transition-colors line-clamp-2 mb-2">
                    <a href={`/blog/${post.id}/`}>
                      {post.data.title}
                    </a>
                  </h3>
                  <p class="text-xs text-zinc-600 line-clamp-2">
                    {post.data.description}
                  </p>
                </div>
                <div class="mt-4 pt-4 border-t border-zinc-100 text-xs text-zinc-400">
                  {new Date(post.data.pubDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Section 5 : Bannière Appel & Devis -->
  <section class="py-20 bg-zinc-900 text-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
        Prêt à concrétiser votre projet de menuiserie en Guadeloupe ?
      </h2>
      <p class="text-base text-zinc-300 max-w-2xl mx-auto mb-10 leading-relaxed">
        Particuliers, architectes, maîtres d'œuvre et promoteurs : confiez vos études à nos techniciens basés à Jarry.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/contact/"
          class="px-8 py-4 rounded-xl bg-sky-600 hover:bg-sky-500 font-extrabold text-sm uppercase tracking-wider text-white transition-all shadow-lg"
        >
          Demander une étude & devis gratuit
        </a>
        <a
          href="tel:0590266440"
          class="px-8 py-4 rounded-xl bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 font-bold text-sm uppercase tracking-wider text-zinc-100 transition-colors"
        >
          Appeler les ateliers : 0590 26 64 40
        </a>
      </div>
    </div>
  </section>
</Layout>
