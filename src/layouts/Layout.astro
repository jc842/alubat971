---
import { siteConfig } from '../config/site.config';
import ReviveSlot from '../components/ads/ReviveSlot.astro';
import MobileStickyAd from '../components/ads/MobileStickyAd.astro';
import Matomo from '../components/analytics/Matomo.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  lang?: 'fr';
}

const {
  title = siteConfig.name,
  description = siteConfig.description,
  image = '/og-image.jpg',
  article = false,
  lang = 'fr',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, siteConfig.url);

// Thème Lexington Bastion Aluminium
const theme = {
  body: 'bg-[#fafafa] text-zinc-900 selection:bg-zinc-800 selection:text-white',
  header: 'bg-white/95 border-zinc-200/90 backdrop-blur-md text-zinc-900',
  accent: 'text-sky-600 hover:text-sky-700',
  badge: 'bg-zinc-100 text-zinc-900 border border-zinc-300',
  footer: 'bg-[#121316] text-zinc-300 border-zinc-800',
};
---

<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title === siteConfig.name ? title : `${title} | ${siteConfig.siteName}`}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Hreflang Tags -->
  <link rel="alternate" hreflang="fr" href={`${siteConfig.url}/`} />
  <link rel="alternate" hreflang="x-default" href={`${siteConfig.url}/`} />

  <!-- Open Graph -->
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, siteConfig.url)} />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={canonicalURL} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <!-- Matomo Tag Manager (Privacy-First / Cookieless / Native Injection) -->
  <Matomo />
</head>

<body class={`min-h-screen flex flex-col ${theme.body} pb-24 md:pb-0 font-sans`}>
  <!-- En-tête / Header Bastion -->
  <header class={`sticky top-0 z-40 backdrop-blur-md border-b shadow-xs ${theme.header}`}>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20">
        <!-- Logo ALUBAT Officiel -->
        <a href="/" class="flex items-center space-x-3 group py-1" aria-label="Accueil ALUBAT Guadeloupe">
          <img
            src="/images/logo-alubat.webp"
            alt="ALUBAT Menuiserie Aluminium Guadeloupe"
            class="h-12 sm:h-14 w-auto object-contain transition-transform group-hover:scale-105"
            width="160"
            height="100"
          />
        </a>

        <!-- Navigation Desktop -->
        <nav class="hidden lg:flex items-center space-x-6 text-xs font-bold uppercase tracking-wider text-zinc-700">
          <a href="/" class="hover:text-sky-600 transition-colors">Accueil</a>
          <a href="/produits/" class="hover:text-sky-600 transition-colors">Gamme Produits</a>
          <a href="/partenaires/" class="hover:text-sky-600 transition-colors">Partenaires</a>
          <a href="/realisations/" class="hover:text-sky-600 transition-colors">Réalisations</a>
          <a href="/blog/" class="hover:text-sky-600 transition-colors">Actualités</a>
          <a href="/nos-valeurs/" class="hover:text-sky-600 transition-colors">Nos Valeurs</a>
          <a href="/architectes/" class="hover:text-sky-600 transition-colors">Architectes</a>
          <a href="/contact/" class="hover:text-sky-600 transition-colors">Contact</a>
        </nav>

        <!-- CTA Header -->
        <div class="flex items-center space-x-3">
          <a
            href="tel:0590266440"
            class="hidden sm:inline-flex items-center space-x-1.5 text-xs font-bold text-zinc-700 hover:text-zinc-950 bg-zinc-100 px-3 py-2 rounded-lg border border-zinc-200"
          >
            <span>📞</span>
            <span>0590 26 64 40</span>
          </a>
          <a
            href="/contact/"
            class="inline-flex items-center justify-center px-4 py-2 rounded-lg bg-sky-600 hover:bg-sky-500 text-white font-bold text-xs uppercase tracking-wider transition-colors shadow-sm"
          >
            Devis Gratuit
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- Bannière Header Publicitaire (si configurée) -->
  {siteConfig.revive?.zones?.header && (
    <div class="bg-zinc-100 py-2 border-b border-zinc-200 hidden md:flex justify-center">
      <ReviveSlot zoneKey="header" />
    </div>
  )}

  <!-- Contenu Principal -->
  <main class="flex-1">
    <slot />
  </main>

  <!-- Pied de page / Footer Bastion BTP -->
  <footer class={`mt-auto border-t ${theme.footer} pt-16 pb-12`}>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
        <!-- Colonne 1 : Entreprise ALUBAT -->
        <div>
          <div class="bg-white rounded-lg p-2.5 w-fit mb-4">
            <img
              src="/images/logo-alubat.webp"
              alt="Logo ALUBAT Guadeloupe"
              class="h-10 w-auto object-contain"
              width="140"
              height="88"
            />
          </div>
          <p class="text-xs text-zinc-400 leading-relaxed mb-4">
            Fabricant et installateur de menuiseries aluminium depuis plus de 40 ans en Guadeloupe. 3 000 m² d'ateliers de production de haute précision à Baie-Mahault (Jarry).
          </p>
          <div class="text-xs text-zinc-400 space-y-1">
            <p>📍 Immeuble ABA 2000, ZAC Moudong Nord</p>
            <p>97122 Baie-Mahault, Guadeloupe</p>
            <p>📞 <a href="tel:0590266440" class="text-zinc-200 hover:underline">0590 26 64 40</a></p>
            <p>🕒 Lun - Ven : 8h00 – 16h00</p>
          </div>
        </div>

        <!-- Colonne 2 : Gamme Aluminium -->
        <div>
          <h3 class="text-xs font-bold uppercase tracking-widest text-zinc-100 mb-4 border-b border-zinc-800 pb-2">
            Gamme Aluminium
          </h3>
          <ul class="text-xs text-zinc-400 space-y-2.5">
            <li><a href="/produits/" class="hover:text-white transition-colors">Baies Coulissantes & Galandages</a></li>
            <li><a href="/biossun/" class="hover:text-white transition-colors">Pergolas Bioclimatiques Biossun</a></li>
            <li><a href="/produits/" class="hover:text-white transition-colors">Fenêtres & Châssis Paracycloniques</a></li>
            <li><a href="/portes-volma/" class="hover:text-white transition-colors">Portes d'Entrée & Blindées Volma</a></li>
            <li><a href="/horizal/" class="hover:text-white transition-colors">Garde-Corps & Barrières Horizal</a></li>
            <li><a href="/dessol/" class="hover:text-white transition-colors">Stores de Terrasse Dessol</a></li>
            <li><a href="/produits/" class="hover:text-white transition-colors">Portes Automatiques & SAS Vitrés</a></li>
          </ul>
        </div>

        <!-- Colonne 3 : Partenaires Référence -->
        <div>
          <h3 class="text-xs font-bold uppercase tracking-widest text-zinc-100 mb-4 border-b border-zinc-800 pb-2">
            Partenaires & Marques
          </h3>
          <ul class="text-xs text-zinc-400 space-y-2.5">
            <li><a href="/partenaires/" class="text-sky-400 hover:text-sky-300 font-semibold transition-colors">→ Annuaire des Partenaires</a></li>
            <li><a href="/schueco/" class="hover:text-white transition-colors">Schüco (Systèmes de profilés)</a></li>
            <li><a href="/biossun/" class="hover:text-white transition-colors">Biossun (Pergolas bioclimatiques)</a></li>
            <li><a href="/horizal/" class="hover:text-white transition-colors">Horizal (Garde-corps & portails)</a></li>
            <li><a href="/portes-volma/" class="hover:text-white transition-colors">Volma (Panneaux de portes)</a></li>
            <li><a href="/dessol/" class="hover:text-white transition-colors">Stores Dessol (Stores d'extérieur)</a></li>
            <li><a href="/saint-gobain/" class="hover:text-white transition-colors">Saint-Gobain (Vitrages & acoustique)</a></li>
          </ul>
        </div>

        <!-- Colonne 4 : Groupe C.P.G. (Filiales) -->
        <div>
          <h3 class="text-xs font-bold uppercase tracking-widest text-zinc-100 mb-4 border-b border-zinc-800 pb-2">
            Groupe C.P.G.
          </h3>
          <p class="text-[11px] text-zinc-400 leading-relaxed mb-3">
            Caraïbes Participation et Gestion — Réseau d'excellence Antilles, Guyane & Métropole :
          </p>
          <ul class="text-xs text-zinc-400 space-y-2">
            <li>
              <a href="https://alubat971.com" class="hover:text-white font-medium text-sky-400 transition-colors">
                • ALUBAT Guadeloupe (Baie-Mahault)
              </a>
            </li>
            <li>
              <a href="http://www.alubat973.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
                • ALUBAT Guyane (Cayenne) ↗
              </a>
            </li>
            <li>
              <a href="http://www.samiversxm.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
                • SAMIVER (Saint-Martin) ↗
              </a>
            </li>
            <li>
              <a href="http://www.tecalu.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
                • TecAlu (Sint Maarten) ↗
              </a>
            </li>
            <li>
              <a href="http://www.alubarth.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
                • ALUBARTH (Saint-Barthélemy) ↗
              </a>
            </li>
            <li>
              <a href="http://www.iris-fenetres.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
                • IRIS Fenêtres (France Métropolitaine) ↗
              </a>
            </li>
          </ul>
        </div>
      </div>

      <!-- Bandeau Réglementaire FEDER / Europe s'engage en Guadeloupe -->
      <div class="my-8 pt-8 border-t border-zinc-800/90">
        <div class="bg-zinc-900/90 border border-zinc-800 rounded-2xl p-5 sm:p-6 flex flex-col md:flex-row items-center justify-between gap-6">
          <div class="flex flex-col sm:flex-row items-center sm:items-start space-y-4 sm:space-y-0 sm:space-x-5 text-center sm:text-left">
            <img
              src="/images/logo-europe-feder-guadeloupe.webp"
              alt="L'Europe s'engage en Guadeloupe avec le Fonds Européen de Développement Régional (FEDER)"
              class="h-14 sm:h-16 w-auto object-contain bg-white rounded-lg p-2 shrink-0 shadow-xs"
              loading="lazy"
            />
            <div>
              <span class="text-[11px] font-extrabold uppercase tracking-widest text-sky-400 block">
                Projet Cofinancé par l'Union Européenne & la Région Guadeloupe
              </span>
              <h4 class="text-sm font-bold text-white mt-1">
                Fonds Européen de Développement Régional (FEDER)
              </h4>
              <p class="text-xs text-zinc-400 mt-1 max-w-3xl leading-relaxed">
                L’Union Européenne et la Région Guadeloupe s’engagent avec le FEDER pour soutenir l’investissement industriel, la modernisation des équipements de fabrication locale et la transition énergétique des bâtiments aux Antilles.
              </p>
            </div>
          </div>
          <span class="text-[10px] uppercase font-bold text-zinc-500 border border-zinc-800 bg-zinc-950 px-3 py-1.5 rounded-md shrink-0">
            Programme FEDER Guadeloupe
          </span>
        </div>
      </div>

      <!-- Ligne de Copyright & Traçabilité -->
      <div class="pt-6 border-t border-zinc-800/80 flex flex-col sm:flex-row items-center justify-between text-xs text-zinc-500 gap-4">
        <div>
          &copy; {new Date().getFullYear()} ALUBAT Guadeloupe (Groupe C.P.G.) — Tous droits réservés.
        </div>
        <div class="flex flex-wrap gap-4 sm:gap-6">
          <a href="/mentions-legales/" class="hover:text-zinc-300 transition-colors">Mentions Légales</a>
          <a href="/politique-confidentialite/" class="hover:text-zinc-300 transition-colors">Politique de Confidentialité</a>
          <a href="/partenaires/" class="hover:text-zinc-300 transition-colors">Partenaires</a>
          <a href="/contact/" class="hover:text-zinc-300 transition-colors">Contact</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- Sticky Mobile Ad (Auto-Collapse) -->
  <MobileStickyAd />
</body>
</html>
