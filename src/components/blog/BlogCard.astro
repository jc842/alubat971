---
import { catLabel } from '../../lib/categories';
import ContentImage from "@/components/fundations/elements/ContentImage.astro";
import Text from "@/components/fundations/elements/Text.astro";
import UnderlinedLink from "@/components/fundations/elements/UnderlinedLink.astro";

interface Props {
  post: any;
}

const { post } = Astro.props;
const url = `/blog/${post.id}/`;
const { title, description, heroImage, category, pubDate } = post.data;
---

<article class="flex flex-col justify-between h-full group">
  <div>
    {heroImage && (
      <a href={url} class="block overflow-hidden rounded bg-base-100">
        <ContentImage
          src={heroImage}
          alt={title}
          width={800}
          height={600}
          loading="lazy"
          class="object-cover object-center w-full aspect-4/3 rounded transition-transform duration-500 group-hover:scale-105"
        />
      </a>
    )}
    <div class="mt-4">
      {category && (
        <span class="text-xs font-semibold uppercase tracking-wider text-accent-700 bg-accent-50 border border-accent-200 rounded px-2.5 py-0.5 inline-block mb-2">
          {catLabel(category)}
        </span>
      )}
      <Text tag="h3" variant="textXL" class="font-bold text-accent-950 group-hover:text-accent-600 transition-colors line-clamp-2">
        <a href={url}>{title}</a>
      </Text>
      {description && (
        <Text tag="p" variant="textBase" class="text-base-600 mt-2 line-clamp-3">
          {description}
        </Text>
      )}
    </div>
  </div>
  <div class="mt-6 pt-4 border-t border-base-200 flex items-center justify-between">
    <span class="text-xs text-base-400">
      {new Date(pubDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' })}
    </span>
    <UnderlinedLink
      href={url}
      title={`Consulter: ${title}`}
      aria-label={`Lire l'article: ${title}`}
      class="text-sm font-semibold"
    >
      Consulter l'étude &rarr;
    </UnderlinedLink>
  </div>
</article>
